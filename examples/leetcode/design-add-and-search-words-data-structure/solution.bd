type TrieNode:
    chars: map[char, TrieNode] = map(TrieNode)
    isEnd: bool = false


type WordDictionary:
    root: TrieNode = TrieNode()

    fn addWord(word: str):
        node = self.root
        for char in word:
            node = node.chars[char]
        node.isEnd = true

    fn search(word: str) bool:
        return matches(self.root, word, 0)


fn matches(node: TrieNode, word: str, start: int) bool:
    for i in start until word.size:
        char = word[i]

        if char == '.':
            return any(
                matches(child, word, i + 1)
                for child in node.chars.values()
            )

        child = node.chars.get(char)
        if child == none:
            return false
        node = child

    return node.isEnd
