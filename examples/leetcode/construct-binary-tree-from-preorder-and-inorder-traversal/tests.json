{
  "entry": "buildTree",
  "argAdapters": [
    "json",
    "json"
  ],
  "resultAdapter": "tree",
  "cases": [
    {
      "name": "standard",
      "args": [
        [3, 9, 20, 15, 7],
        [9, 3, 15, 20, 7]
      ],
      "expected": [3, 9, 20, null, null, 15, 7]
    },
    {
      "name": "empty",
      "args": [
        [],
        []
      ],
      "expected": []
    },
    {
      "name": "single-zero",
      "args": [
        [0],
        [0]
      ],
      "expected": [0]
    },
    {
      "name": "left-chain",
      "args": [
        [4, 3, 2, 1],
        [1, 2, 3, 4]
      ],
      "expected": [4, 3, null, 2, null, 1]
    },
    {
      "name": "right-chain-with-zero-split",
      "args": [
        [-3, -2, -1, 0],
        [-3, -2, -1, 0]
      ],
      "expected": [-3, null, -2, null, -1, null, 0]
    },
    {
      "name": "complete-tree",
      "args": [
        [1, 2, 4, 5, 3, 6, 7],
        [4, 2, 5, 1, 6, 3, 7]
      ],
      "expected": [1, 2, 3, 4, 5, 6, 7]
    },
    {
      "name": "sparse-subtrees",
      "args": [
        [1, 2, 4, 6, 3, 5, 7],
        [2, 6, 4, 1, 5, 7, 3]
      ],
      "expected": [1, 2, 3, null, 4, 5, null, 6, null, null, 7]
    },
    {
      "name": "negative-and-zero-values",
      "args": [
        [0, -1, -2, 2, 1, 3],
        [-2, -1, 0, 1, 2, 3]
      ],
      "expected": [0, -1, 2, -2, null, 1, 3]
    },
    {
      "name": "non-bst-value-order",
      "args": [
        [8, 10, 1, 9, 4, 3],
        [1, 10, 9, 8, 3, 4]
      ],
      "expected": [8, 10, 4, 1, 9, 3]
    },
    {
      "name": "exact-large-values",
      "args": [
        [9007199254740993, 9007199254740992, 9007199254740994],
        [9007199254740992, 9007199254740993, 9007199254740994]
      ],
      "expected": [9007199254740993, 9007199254740992, 9007199254740994]
    }
  ]
}
