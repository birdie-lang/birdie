{
  "entry": "levelOrder",
  "argAdapters": [
    "tree"
  ],
  "cases": [
    {
      "name": "standard-levels",
      "args": [
        [
          3,
          9,
          20,
          null,
          null,
          15,
          7
        ]
      ],
      "expected": [
