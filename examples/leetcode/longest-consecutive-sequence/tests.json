{
  "entry": "longestConsecutive",
  "cases": [
    {
      "name": "unordered-run",
      "args": [
        [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      ],
      "expected": 4
    },
    {
      "name": "empty",
      "args": [
        []
      ],
      "expected": 0
    },
    {
      "name": "duplicates",
      "args": [
        [
          1,
          0,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "name": "negative-run",
      "args": [
        [
          -3,
          -2,
          -1,
          5
        ]
      ],
      "expected": 3
    },
    {
      "name": "single",
      "args": [
        [
          5
        ]
      ],
      "expected": 1
    },
    {
      "name": "long-run",
      "args": [
        [
          0,
          3,
          7,
          2,
          5,
          8,
          4,
          6,
          0,
          1
        ]
      ],
      "expected": 9
    }
  ]
}
