{
  "entry": "containsDuplicate",
  "cases": [
    {
      "name": "repeated-value",
      "args": [
        [
          1,
          2,
          3,
          1
        ]
      ],
      "expected": true
    },
    {
      "name": "distinct-values",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": false
    },
    {
      "name": "empty",
      "args": [
        []
      ],
      "expected": false
    },
    {
      "name": "single",
      "args": [
        [
          7
        ]
      ],
      "expected": false
    },
    {
      "name": "negative-duplicate",
      "args": [
        [
          -2,
          0,
          -2
        ]
      ],
      "expected": true
    },
    {
      "name": "duplicate-at-end",
      "args": [
        [
          1,
          2,
          3,
          4,
          4
        ]
      ],
      "expected": true
    }
  ]
}
