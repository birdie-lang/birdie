{
  "entry": "productExceptSelf",
  "cases": [
    {
      "name": "standard",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        24,
        12,
        8,
        6
      ]
    },
    {
      "name": "one-zero",
      "args": [
        [
          -1,
          1,
          0,
          -3,
          3
        ]
      ],
      "expected": [
        0,
        0,
        9,
        0,
        0
      ]
    },
    {
      "name": "two-zeros",
      "args": [
        [
          0,
          2,
          0
        ]
      ],
      "expected": [
        0,
        0,
        0
      ]
    },
    {
      "name": "negative-values",
      "args": [
        [
          -1,
          -2,
          -3
        ]
      ],
      "expected": [
        6,
        3,
        2
      ]
    },
    {
      "name": "two-values",
      "args": [
        [
          2,
          3
        ]
      ],
      "expected": [
        3,
        2
      ]
    },
    {
      "name": "all-ones",
      "args": [
        [
          1,
          1,
          1
        ]
      ],
      "expected": [
        1,
        1,
        1
      ]
    }
  ]
}
