fn diameterOfBinaryTree(root: TreeNode?) int:
    diameter = 0

    fn dfs(node: TreeNode?) int:
        outer diameter

        if node == none:
            return 0

        left = dfs(node.left)
        right = dfs(node.right)

        max!(diameter, left + right)

        return 1 + max(left, right)

    dfs(root)
    return diameter
