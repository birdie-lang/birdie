{
  "entry": "kthSmallest",
  "argAdapters": [
    "tree",
    "json"
  ],
  "cases": [
    {
      "name": "standard-first",
      "args": [
        [3, 1, 4, null, 2],
        1
      ],
      "expected": 1
    },
    {
      "name": "standard-third",
      "args": [
        [5, 3, 6, 2, 4, null, null, 1],
        3
      ],
      "expected": 3
    },
    {
      "name": "single-zero",
      "args": [
        [0],
        1
      ],
      "expected": 0
    },
    {
      "name": "zero-returned-from-left",
      "args": [
        [1, 0, 2],
        1
      ],
      "expected": 0
    },
    {
      "name": "zero-returned-from-right",
      "args": [
        [-1, -2, 0],
        3
      ],
      "expected": 0
    },
    {
      "name": "zero-after-negative-subtree",
      "args": [
        [0, -3, 4, -5, -1, 2, 6],
        4
      ],
      "expected": 0
    },
    {
      "name": "largest-rank",
      "args": [
        [4, 2, 6, 1, 3, 5, 7],
        7
      ],
      "expected": 7
    },
    {
      "name": "internal-rank-in-right-subtree",
      "args": [
        [4, 2, 6, 1, 3, 5, 7],
        5
      ],
      "expected": 5
    },
    {
      "name": "left-chain",
      "args": [
        [4, 3, null, 2, null, 1],
        2
      ],
      "expected": 2
    },
    {
      "name": "right-chain",
      "args": [
        [-3, null, -2, null, -1, null, 0],
        2
      ],
      "expected": -2
    },
    {
      "name": "exact-result-above-float-precision",
      "args": [
        [9007199254740993, 9007199254740992, 9007199254740994],
        2
      ],
      "expected": 9007199254740993
    }
  ]
}
