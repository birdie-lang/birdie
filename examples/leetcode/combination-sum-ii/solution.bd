fn combinationSum2(candidates: list[int], target: int) list[list[int]]:
    candidates.sort()
    res = []
    subset = []

    fn dfs(total: int, start: int):
        if total == target:
            res.push(subset.copy())
            return

        for i in start until candidates.size:
            num = candidates[i]
            if total + num > target:
                return
            if i > start and num == candidates[i - 1]:
                continue

            subset.push(num)
            dfs(total + num, i + 1)
            subset.pop()

    dfs(0, 0)
    return res
