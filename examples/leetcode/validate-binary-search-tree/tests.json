{
  "entry": "isValidBST",
  "argAdapters": [
    "tree"
  ],
  "cases": [
    {
      "name": "standard-valid",
      "args": [
        [2, 1, 3]
      ],
      "expected": true
    },
    {
      "name": "standard-invalid",
      "args": [
        [5, 1, 4, null, null, 3, 6]
      ],
      "expected": false
    },
    {
      "name": "empty",
      "args": [
        []
      ],
      "expected": true
    },
    {
      "name": "single-zero",
      "args": [
        [0]
      ],
      "expected": true
    },
    {
      "name": "duplicate-left",
      "args": [
        [2, 2, 3]
      ],
      "expected": false
    },
    {
      "name": "duplicate-right",
      "args": [
        [2, 1, 2]
      ],
      "expected": false
    },
    {
      "name": "violates-ancestor-upper-bound",
      "args": [
        [10, 5, 15, null, 12]
      ],
      "expected": false
    },
    {
      "name": "violates-ancestor-lower-bound",
      "args": [
        [10, 5, 15, null, null, 6, 20]
      ],
      "expected": false
    },
    {
      "name": "negative-and-positive-values",
      "args": [
        [0, -3, 4, -5, -1, 2, 6]
      ],
      "expected": true
    },
    {
      "name": "left-chain",
      "args": [
        [4, 3, null, 2, null, 1]
      ],
      "expected": true
    },
    {
      "name": "right-chain",
      "args": [
        [-3, null, -2, null, -1, null, 0]
      ],
      "expected": true
    },
    {
      "name": "signed-32-bit-boundaries",
      "args": [
        [0, -2147483648, 2147483647]
      ],
      "expected": true
    },
    {
      "name": "distinct-above-float-precision",
      "args": [
        [9007199254740993, 9007199254740992, 9007199254740994]
      ],
      "expected": true
    },
    {
      "name": "decreasing-above-float-precision",
      "args": [
        [9007199254740993, null, 9007199254740992]
      ],
      "expected": false
    },
    {
      "name": "arbitrary-precision-positive-boundaries",
      "args": [
        [
          10000000000000000000000000000000000000000,
          9999999999999999999999999999999999999999,
          10000000000000000000000000000000000000001
        ]
      ],
      "expected": true
    },
    {
      "name": "arbitrary-precision-negative-boundaries",
      "args": [
        [
          -10000000000000000000000000000000000000000,
          -10000000000000000000000000000000000000001,
          -9999999999999999999999999999999999999999
        ]
      ],
      "expected": true
    }
  ]
}
