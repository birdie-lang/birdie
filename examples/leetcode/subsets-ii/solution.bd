fn subsetsWithDup(nums: list[int]) list[list[int]]:
    nums.sort()
    res = []
    subset = []

    fn dfs(i: int):
        if i >= nums.size:
            res.push(subset.copy())
            return

        subset.push(nums[i])
        dfs(i + 1)
        subset.pop()

        while i + 1 < nums.size and nums[i] == nums[i + 1]:
            i++
        dfs(i + 1)

    dfs(0)
    return res
