{
  "entry": "subsetsWithDup",
  "check": "unordered-groups",
  "cases": [
    {
      "name": "standard",
      "args": [[1, 2, 2]],
      "expected": [[], [1], [2], [1, 2], [2, 2], [1, 2, 2]]
    },
    {
      "name": "single-zero",
      "args": [[0]],
      "expected": [[], [0]]
    },
    {
      "name": "all-equal",
      "args": [[4, 4, 4]],
      "expected": [[], [4], [4, 4], [4, 4, 4]]
    },
    {
      "name": "unsorted-duplicate-runs",
      "args": [[2, -1, 2, -1]],
      "expected": [[], [-1], [2], [-1, -1], [-1, 2], [2, 2], [-1, -1, 2], [-1, 2, 2], [-1, -1, 2, 2]]
    },
    {
      "name": "distinct-values",
      "args": [[3, 1, 2]],
      "expected": [[], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]]
    },
    {
      "name": "empty-input",
      "args": [[]],
      "expected": [[]]
    }
  ]
}
