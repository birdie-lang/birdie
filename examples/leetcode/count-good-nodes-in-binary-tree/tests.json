{
  "entry": "goodNodes",
  "argAdapters": [
    "tree"
  ],
  "cases": [
    {
      "name": "standard-branches",
      "args": [
        [
          3,
          1,
          4,
          3,
          null,
          1,
          5
        ]
      ],
      "expected": 4
    },
    {
      "name": "equal-root-then-larger-child",
      "args": [
        [
          3,
          3,
          null,
          4,
          2
        ]
      ],
      "expected": 3
    },
    {
      "name": "single",
      "args": [
        [
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "zero-values",
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": 3
    },
    {
      "name": "increasing-chain",
      "args": [
        [
          1,
          null,
          2,
          null,
          3,
          null,
          4
        ]
      ],
      "expected": 4
    },
    {
      "name": "decreasing-chain",
      "args": [
        [
          4,
          3,
          null,
          2,
          null,
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "equal-values",
      "args": [
        [
          2,
          2,
          2,
          2,
          2
        ]
      ],
      "expected": 5
    },
    {
      "name": "negative-path-maxima",
      "args": [
        [
          -3,
          -4,
          -2,
          -5,
          -3,
          -2,
          -1
        ]
      ],
      "expected": 5
    },
    {
      "name": "independent-sibling-maxima",
      "args": [
        [
          5,
          10,
          6
        ]
      ],
      "expected": 3
    },
    {
      "name": "maximum-from-earlier-ancestor",
      "args": [
        [
          5,
          1,
          4,
          3,
          6,
          2,
          7
        ]
      ],
      "expected": 3
    }
  ]
}
