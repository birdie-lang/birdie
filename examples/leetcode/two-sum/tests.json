{
  "entry": "twoSum",
  "check": "unordered",
  "cases": [
    {
      "name": "standard",
      "args": [
        [
          2,
          7,
          11,
          15
        ],
        9
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "name": "later-pair",
      "args": [
        [
          3,
          2,
          4
        ],
        6
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "name": "equal-values",
      "args": [
        [
          3,
          3
        ],
        6
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "name": "negative-values",
      "args": [
        [
          -3,
          4,
          3,
          90
        ],
        0
      ],
      "expected": [
        0,
        2
      ]
    },
    {
      "name": "zero-values",
      "args": [
        [
          0,
          4,
          3,
          0
        ],
        0
      ],
      "expected": [
        0,
        3
      ]
    },
    {
      "name": "no-pair-fallback",
      "args": [
        [
          1,
          2
        ],
        8
      ],
      "expected": []
    }
  ]
}
