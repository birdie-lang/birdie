fn combinationSum(candidates: list[int], target: int) list[list[int]]:
    res = []
    subset = []

    fn dfs(total: int, start: int):
        if total >= target:
            if total == target:
                res.push(subset.copy())
            return

        for i in start until candidates.size:
            num = candidates[i]
            if total + num > target:
                continue

            subset.push(num)
            dfs(total + num, i)
            subset.pop()

    dfs(0, 0)
    return res
