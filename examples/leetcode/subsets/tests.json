{
  "entry": "subsets",
  "check": "unordered-groups",
  "cases": [
    {
      "name": "standard",
      "args": [[1, 2, 3]],
      "expected": [[], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]]
    },
    {
      "name": "empty-input",
      "args": [[]],
      "expected": [[]]
    },
    {
      "name": "single-zero",
      "args": [[0]],
      "expected": [[], [0]]
    },
    {
      "name": "single-negative",
      "args": [[-4]],
      "expected": [[], [-4]]
    },
    {
      "name": "two-elements",
      "args": [[4, 7]],
      "expected": [[], [4], [7], [4, 7]]
    },
    {
      "name": "unsorted-input",
      "args": [[3, 1, 2]],
      "expected": [[], [1], [2], [3], [1, 2], [1, 3], [2, 3], [1, 2, 3]]
    },
    {
      "name": "negative-zero-positive",
      "args": [[-2, 0, 3]],
      "expected": [[], [-2], [0], [3], [-2, 0], [-2, 3], [0, 3], [-2, 0, 3]]
    },
    {
      "name": "exact-large-integers",
      "args": [[9007199254740993, -10000000000000000000000000000000000000001]],
      "expected": [
        [],
        [9007199254740993],
        [-10000000000000000000000000000000000000001],
        [9007199254740993, -10000000000000000000000000000000000000001]
      ]
    }
  ]
}
